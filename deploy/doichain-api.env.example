# Vorlage der Umgebungsdatei /etc/doichain-api/doichain-api.env (root:doiapi, 0640).
# install.sh legt die Datei beim ersten Lauf mit zufaelligen Schluesseln an und uebernimmt den
# RPC-Zugang aus /home/doichain/.doichain/doichain.conf. Die echte Datei nie ins Repo oder in Notizen kopieren.

DOI_RPC_URL=http://127.0.0.1:8339/
DOI_RPC_USER=admin
DOI_RPC_PASSWORD=BITTE-EINTRAGEN
DOI_RPC_WALLET=doichain

DOI_ELECTRUM_HOST=127.0.0.1
DOI_ELECTRUM_PORT=50001
DOI_EXPLORER_URL=https://doi-explorer.le-space.de

# Lesen ohne Schluessel erlauben (true) oder Leseschluessel verlangen (false)
DOI_PUBLIC_READ=true

# Schluessel je Stufe, kommagetrennt, nur ASCII, mindestens 16 Zeichen. Erzeugen mit: openssl rand -hex 24
DOI_API_KEYS_READ=
DOI_API_KEYS_WRITE=BITTE-ERZEUGEN
DOI_API_KEYS_ADMIN=BITTE-ERZEUGEN

# Namenspraefix der Nachweise (nach dem ersten Nachweis nicht mehr aendern)
DOI_POE_PREFIX=poe/
DOI_MAX_UPLOAD_BYTES=52428800
