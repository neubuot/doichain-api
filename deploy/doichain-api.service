[Unit]
Description=Doichain REST API (FastAPI vor Doichain Core)
Documentation=https://api.doi.zone/docs
After=network-online.target doichaind.service
Wants=network-online.target

[Service]
Type=simple
User=doiapi
Group=doiapi
EnvironmentFile=/etc/doichain-api/doichain-api.env
WorkingDirectory=/opt/doichain-api/app
ExecStart=/opt/doichain-api/venv/bin/uvicorn doichain_api.main:app --host 127.0.0.1 --port 8080 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
